# Optional when the Colyseus server is not on the browser host at port 2567.
VITE_COLYSEUS_URL=http://localhost:2567

# Server-side defaults; use task-specific names to avoid colliding with system variables.
PAPER_KART_SERVER_HOST=0.0.0.0
PAPER_KART_SERVER_PORT=2567

# Stage 04 cloud accounts. These browser-safe project values come from
# Supabase Dashboard > Project Settings > API. Never put a service-role key here.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_project_key
